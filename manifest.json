{
  "manifest_version": 3,
  "name": "Compteur de fautes – Silent Teacher",
  "version": "4.1.4",
  "description": "Suit Silent Teacher et propose un test d'anglais pour les programmeurs de jeux vidéo 2D.",
  "permissions": ["downloads"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["english-test.html", "english-test.css", "english-test.js"],
      "matches": ["https://silentteacher.toxicode.fr/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://silentteacher.toxicode.fr/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
