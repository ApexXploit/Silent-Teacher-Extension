{
  "manifest_version": 3,
  "name": "Compteur de fautes – Silent Teacher",
  "version": "4.0.3",
  "description": "Suit Silent Teacher et propose un test d'anglais pour les programmeurs de jeux vidéo 2D.",
  "permissions": ["downloads"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://silentteacher.toxicode.fr/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
